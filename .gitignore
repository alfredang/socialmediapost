# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (root and nested, e.g. sdks/*)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
uploads/
prisma/dev.db
prisma/*.db-journal
.playwright-mcp/
*.log

certificates

# Claude Code harness (skills installed from skills-lock.json, agent memory)
.agents/
memory/
.claude/settings.local.json

# python
__pycache__/

# Distribution archives (rebuildable — never pushed to GitHub)
*.zip

# Source material the project was derived from — not ours to republish.
**/reference/

# third-party skills come from skills-lock.json; only project-specific skills are tracked
.claude/skills/*
!.claude/skills/frontend-design/
!.claude/skills/readme-sync/