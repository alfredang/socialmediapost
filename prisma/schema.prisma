generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String   @id @default(cuid())
  email             String   @unique
  name              String?
  role              String   @default("user") // user|admin
  passwordHash      String
  // Never default to a paid tier: a row created without an explicit plan must
  // land on the free plan, not silently receive a plan nobody paid for.
  plan              String   @default("free") // free|basic|professional|advanced|business
  planInterval      String   @default("monthly") // monthly|yearly

  // Stripe linkage. `plan` above is a cache of what Stripe says this account is
  // entitled to — only the webhook may write it, never a user-facing request.
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  subscriptionStatus   String? // active|trialing|past_due|canceled|incomplete
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean   @default(false)
  calendarWeekStart String   @default("monday")
  webhookUrl        String?
  createdAt         DateTime @default(now())

  profiles      Profile[]
  apiKeys       ApiKey[]
  apiLogs       ApiRequestLog[]
  invoices      Invoice[]
  notifications Notification[]
  ffmpegJobs    FfmpegJob[]
  teamInvites   TeamInvite[]
  connectedApps ConnectedApp[]
}

model Profile {
  id        String   @id @default(cuid())
  name      String
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  socialAccounts SocialAccount[]
  posts          Post[]
  queueSetting   QueueSetting?
  pipelines      Pipeline[]
  snapshots      AnalyticsSnapshot[]

  @@unique([accountId, name])
}

model SocialAccount {
  id             String    @id @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform       String
  handle         String
  displayName    String?
  status         String    @default("connected") // connected|needs_reauth|pending_page (FB awaiting Page pick)
  externalUserId String? // platform account id (e.g. Instagram user id, Facebook Page id, TikTok open_id)
  accessToken    String? // OAuth token; null for simulated/demo connections
  tokenExpiresAt DateTime? // when accessToken expires (long-lived IG token ~60d, TikTok ~24h)
  refreshToken   String? // OAuth refresh token (TikTok 365d); null when the platform has none
  meta           String? // JSON platform extras (e.g. Facebook: {userToken,pages}, TikTok: {refreshExpiresAt})
  createdAt      DateTime  @default(now())

  @@unique([profileId, platform])
}

model ApiKey {
  id         String    @id @default(cuid())
  accountId  String
  account    Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  label      String    @default("Default Key")
  hashedKey  String    @unique
  prefix     String
  status     String    @default("active") // active|revoked
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}

model ApiRequestLog {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  endpoint  String
  method    String
  status    Int
  createdAt DateTime @default(now())
}

model Post {
  id             String    @id @default(cuid())
  requestId      String    @unique @default(cuid())
  profileId      String
  profile        Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  type           String // video|photos|text|document
  title          String    @default("")
  description    String    @default("")
  firstComment   String    @default("")
  mediaFiles     String    @default("[]") // JSON [{path,name,size,mime}]
  status         String    @default("queued") // draft|scheduled|queued|publishing|published|failed|partial
  source         String    @default("api") // api|manual|pipeline|csv
  scheduledAt    DateTime?
  idempotencyKey String?   @unique
  createdAt      DateTime  @default(now())

  targets PostTarget[]
}

model PostTarget {
  id           String    @id @default(cuid())
  postId       String
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  platform     String
  adaptedTitle String    @default("")
  adaptedBody  String    @default("")
  firstComment String    @default("")
  // Per-platform content overrides. Null → use the post's base type/mediaFiles.
  // Lets one post publish e.g. a video to TikTok and photos to Instagram.
  type         String?
  mediaFiles   String?   // JSON StoredFile[]
  status       String    @default("pending") // pending|publishing|published|failed
  externalUrl  String?
  externalId   String?
  error        String?
  publishedAt  DateTime?

  metrics PostMetric[]
}

model PostMetric {
  id        String     @id @default(cuid())
  targetId  String
  target    PostTarget @relation(fields: [targetId], references: [id], onDelete: Cascade)
  views     Int        @default(0)
  likes     Int        @default(0)
  comments  Int        @default(0)
  shares    Int        @default(0)
  createdAt DateTime   @default(now())
}

// One row per profile+platform+day, written ONLY by the real platform sync in
// src/lib/analytics-sync.ts. Metrics are nullable on purpose: null means "this
// platform does not expose that number to us", which is different from a
// measured zero. Nothing here is ever estimated or generated.
model AnalyticsSnapshot {
  id          String   @id @default(cuid())
  profileId   String
  profile     Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  platform    String
  date        DateTime
  followers   Int?
  reach       Int?
  impressions Int?
  views       Int?
  likes       Int?
  comments    Int?
  shares      Int?
  collectedAt DateTime @default(now())

  @@unique([profileId, platform, date])
}

model QueueSetting {
  id             String  @id @default(cuid())
  profileId      String  @unique
  profile        Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  timezone       String  @default("America/New_York")
  activeDays     String  @default("[\"mon\",\"tue\",\"wed\",\"thu\",\"fri\",\"sat\",\"sun\"]")
  slotTimes      String  @default("[\"09:00\",\"12:00\",\"17:00\"]")
  maxPerSlot     Int     @default(1)
}

model Pipeline {
  id         String   @id @default(cuid())
  profileId  String
  profile    Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  name       String
  platforms  String   @default("[]")
  timezone   String   @default("America/New_York")
  activeDays String   @default("[\"mon\",\"wed\",\"fri\"]")
  slotTimes  String   @default("[\"10:00\"]")
  status     String   @default("active") // active|paused
  loop       Boolean  @default(false)
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())

  items PipelineItem[]
}

model PipelineItem {
  id          String    @id @default(cuid())
  pipelineId  String
  pipeline    Pipeline  @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  order       Int
  title       String    @default("")
  description String    @default("")
  mediaFiles  String    @default("[]") // base media (default for platforms w/o override)
  type        String    @default("text") // base type
  // Per-platform content: JSON { [platform]: { type, media: StoredFile[] } }.
  // A platform absent here uses the base type/mediaFiles above.
  perPlatform String    @default("{}")
  status      String    @default("pending") // pending|published
  publishedAt DateTime?
}

// Mirrors invoices Stripe has actually issued. Rows are written only by the
// Stripe webhook, so an invoice existing here means money genuinely moved —
// nothing in the app may mint one directly.
model Invoice {
  id               String   @id @default(cuid())
  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  number           String   @unique
  total            Float
  currency         String   @default("usd")
  status           String   @default("paid") // paid|open|void|uncollectible
  stripeInvoiceId  String?  @unique
  hostedInvoiceUrl String?
  invoicePdfUrl    String?
  createdAt        DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      String   @default("info") // success|error|info
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model FfmpegJob {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  command   String
  minutes   Float    @default(0)
  status    String   @default("completed")
  createdAt DateTime @default(now())
}

model TeamInvite {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  email     String
  role      String   @default("member")
  status    String   @default("pending")
  createdAt DateTime @default(now())
}

model ConnectedApp {
  id        String   @id @default(cuid())
  accountId String
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name      String
  scopes    String   @default("[]")
  createdAt DateTime @default(now())
}

model OtpCode {
  id        String    @id @default(cuid())
  email     String
  code      String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Instance-wide configuration entered by an admin in /settings, so an operator
// can set up OAuth and SMTP without a redeploy. One row per setting key.
//
// `value` holds plaintext for non-sensitive keys (SMTP_HOST, MAIL_FROM) and a
// secret-box ciphertext when `encrypted` is true (SMTP_PASS, *_CLIENT_SECRET).
// Environment variables always take precedence — see lib/settings.ts.
model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
  updatedBy String?
}
